    "/api/v1/logs": {
      "get": {
        "responses": {
          "200": {
            "description": "Logs"
          }
        },
        "summary": "List/export logs"
      },
      "post": {
        "responses": {
          "200": {
            "description": "Cleared"
          }
        },
        "summary": "Clear logs"
      }
    },
    "/api/v1/openapi.json": {
      "get": {
        "responses": {
          "200": {
            "description": "OpenAPI JSON"
          }
        },
        "security": [],
        "summary": "OpenAPI document"
      }
    },
    "/api/v1/program": {
