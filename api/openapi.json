      "get": {
        "responses": {
          "200": {
            "description": "Tokens"
          }
        },
        "summary": "List token metadata"
      },
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TokenAction"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token result"
          }
        },
        "summary": "Create or revoke tokens"
      }
    },
    "/api/v1/config": {
      "get": {
        "responses": {
          "200": {
            "description": "Config"
          }
        },
        "summary": "Read SIP config"
      },
      "post": {
        "responses": {
          "200": {
            "description": "Updated"
          }
        },
        "summary": "Set SIP config value"
      }
