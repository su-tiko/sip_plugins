{
  "components": {
    "schemas": {
      "ConfigValue": {
        "properties": {
          "key": {
            "type": "string"
          },
          "value": {}
        },
        "type": "object"
      },
      "Envelope": {
        "properties": {
          "data": {},
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Error"
              },
              {
                "type": "null"
              }
            ]
          },
          "meta": {
            "type": "object"
          },
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "ok",
          "data",
          "error",
          "meta"
        ],
        "type": "object"
      },
      "Error": {
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "LogEntry": {
        "type": "object"
      },
      "Program": {
        "properties": {
          "enabled": {
            "type": "integer"
          },
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "ProgramAction": {
        "properties": {
          "action": {
            "enum": [
              "create",
              "update",
              "run",
              "enable",
              "disable",
              "delete",
              "import"
            ],
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "program": {
            "$ref": "#/components/schemas/Program"
          }
        },
        "type": "object"
      },
      "RunOnceRequest": {
        "properties": {
          "preempt": {
            "type": "boolean"
          },
          "stations": {
            "items": {
              "properties": {
                "duration": {
                  "type": "integer"
                },
                "station": {
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "Station": {
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "remaining": {
            "type": "integer"
          },
          "state": {
            "type": "integer"
          }
        },
        "type": "object"
      },
      "StationAction": {
        "properties": {
          "action": {
            "enum": [
              "on",
              "off",
              "stop_all",
              "rename",
              "enable",
              "disable",
              "set_option"
            ],
            "type": "string"
          },
          "duration": {
            "type": "integer"
          },
          "id": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "TokenAction": {
        "properties": {
          "action": {
            "enum": [
              "create",
              "revoke"
            ],
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "TokenMetadata": {
        "properties": {
          "created_at": {
            "type": "integer"
          },
          "expires_at": {
            "type": [
              "integer",
              "null"
            ]
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "revoked": {
            "type": "boolean"
          },
          "scopes": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "scheme": "bearer",
        "type": "http"
      },
      "cookieAuth": {
        "in": "cookie",
        "name": "webpy_session_id",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "Generic JSON API v1 for SIP and sipctl.",
    "title": "SIP Generic API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
