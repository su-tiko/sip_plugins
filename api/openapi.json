      "post": {
        "responses": {
          "200": {
            "description": "Accepted"
          }
        },
        "summary": "Server operations"
      }
    },
    "/api/v1/station": {
      "get": {
        "parameters": [
          {
            "in": "query",
            "name": "id",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Station"
          }
        },
        "summary": "Show one station"
